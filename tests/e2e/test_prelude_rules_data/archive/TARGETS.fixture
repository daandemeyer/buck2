load("//:defs.bzl", "tarball", "unpack")

tarball(name = "pages")

unpack(
    name = "unpacked",
    archive = ":pages",
    excludes = ["\\[id\\]\\.js$"],
)

unpack(
    name = "directory_exclusion",
    archive = read_config("test", "directory_archive", ":pages"),
    excludes = ["^top/bin$"],
)
